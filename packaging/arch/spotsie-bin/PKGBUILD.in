# Maintainer: Ahaan Shah <ahaanshah04@gmail.com>
pkgname=spotsie-bin
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc="Native Spotify client"
arch=('x86_64' 'aarch64')
url="https://github.com/ahaan-shah/spotsie"
license=('MIT')
install="${pkgname}.install"
# alsa-lib and libpulse are linked directly; the rest are dlopened by winit
# and glutin at startup, and this is a GUI-only application, so all of them
# have to be there for it to run at all.
depends=('dbus' 'alsa-lib' 'libpulse' 'libglvnd' 'libxkbcommon' 'wayland' 'libx11')
optdepends=('libxkbcommon-x11: keyboard handling in X11 sessions'
            'pipewire-pulse: PipeWire as the PulseAudio server')
provides=("spotsie=$pkgver")
conflicts=('spotsie' 'spotsie-git')
options=('!debug' '!strip')
_repo="https://github.com/ahaan-shah/spotsie"
source_x86_64=("${_repo}/releases/download/v${pkgver}/spotsie-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("${_repo}/releases/download/v${pkgver}/spotsie-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@AMD64_SHA256@')
sha256sums_aarch64=('@ARM64_SHA256@')

package() {
  local target
  case "$CARCH" in
    x86_64) target="x86_64-unknown-linux-gnu" ;;
    aarch64) target="aarch64-unknown-linux-gnu" ;;
  esac
  local dir="${srcdir}/spotsie-v${pkgver}-${target}"

  install -Dm755 "${dir}/spotsie" "${pkgdir}/usr/bin/spotsie"
  install -Dm644 "${dir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${dir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${dir}/packaging/applications/spotsie.desktop" \
    "${pkgdir}/usr/share/applications/spotsie.desktop"
  install -Dm644 "${dir}/packaging/icons/spotsie.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/spotsie.svg"
  # Older release fixtures predate the optional integration.
  if [[ -d "${dir}/contrib/omarchy" ]]; then
    install -Dm644 "${dir}/contrib/omarchy/spotsie.json.tpl" "${pkgdir}/usr/share/spotsie/omarchy/spotsie.json.tpl"
    install -Dm755 "${dir}/contrib/omarchy/spotsie-theme" "${pkgdir}/usr/share/spotsie/omarchy/spotsie-theme"
  fi
}
